# Privy (production auth). The app ID is yours to supply; add chrome-extension://<extension-id> to its allowed origins.
VITE_PRIVY_APP_ID=
VITE_PRIVY_CLIENT_ID=
# Gami services (HTTPS in production)
VITE_GAMI_API_URL=
VITE_GAMI_MCP_URL=
VITE_NOVA_API_URL=
# Development only. Must NOT be "true" for package:chrome.
VITE_GAMI_DEV_MOCK=false
