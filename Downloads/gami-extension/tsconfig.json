{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": true, "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true, "skipLibCheck": true, "noEmit": true, "isolatedModules": true,
    "types": ["chrome", "vite/client", "node"], "resolveJsonModule": true
  },
  "include": ["src", "tests", "vite.config.ts", "vite.content.config.ts", "vitest.config.ts"]
}
