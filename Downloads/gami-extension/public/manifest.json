{
  "manifest_version": 3,
  "name": "Gami",
  "version": "0.1.0",
  "description": "Quest the web. Earn with Gami. Discover and complete Gami quests on the website you are visiting.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Gami", "default_popup": "popup.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "activeTab", "scripting", "sidePanel"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
